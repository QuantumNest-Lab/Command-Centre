DATABASE_URL=postgres://qnl:qnl_local_password@localhost:5432/qnl_command_centre
SESSION_SECRET=replace-with-a-unique-32-character-minimum-secret
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
# Security tests never use DATABASE_URL. Configure this locally in .env.test
# with a disposable database ending in _test (for example qnl_command_centre_test).
TEST_DATABASE_URL=postgres://qnl:replace-local-password@localhost:5432/qnl_command_centre_test
