DATABASE_URL=postgres://qnl:qnl_local_password@localhost:5432/qnl_command_centre
# Use a unique random value of at least 32 characters. Do not commit .env.local.
SESSION_SECRET=replace-with-a-unique-32-character-minimum-secret
# Public origin used for invitation links, OAuth callbacks, and webhook return URLs.
APP_URL=http://localhost:3000
# Server-only reference to a managed secret store. Do not place provider tokens,
# OAuth client secrets, SMTP passwords, or payment keys in NEXT_PUBLIC_* variables.
SECRET_STORE_REFERENCE=local-development-only
# Transactional email: configure these as encrypted deployment secrets, never in NEXT_PUBLIC_*.
SMTP_HOST=smtp.stackmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@quantumnestlab.com
SMTP_PASSWORD=replace-with-the-noreply-mailbox-password
SMTP_FROM="QNL Command Centre <noreply@quantumnestlab.com>"
